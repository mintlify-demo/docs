{
  "openapi": "3.1.0",
  "info": {
    "title": "Merge Sort API",
    "summary": "Sort numbers with merge sort and watch how it works.",
    "description": "A tiny demo API that sorts a list of numbers using the merge sort algorithm.\n\nUse `POST /sort` when you just want the answer, and `POST /sort/steps` when you want to see every merge along the way. Use `POST /sort/stats` to compare how long quick sort, merge sort, and heap sort take on the same input.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/sort": {
      "post": {
        "tags": [
          "Sorting"
        ],
        "summary": "Sort numbers",
        "description": "Sort a list of numbers in ascending or descending order.\n\nThe sort is **stable** and runs in O(n log n) time. An empty list is valid\nand returns an empty list.",
        "operationId": "sortNumbers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sort/steps": {
      "post": {
        "tags": [
          "Sorting"
        ],
        "summary": "Sort numbers and return every merge step",
        "description": "Sort a list of numbers and return each merge as it happened.\n\nEach step shows the two sorted halves (`left` and `right`) and the list they\nwere merged into. The last step's `merged` list is the final result.",
        "operationId": "sortNumbersWithSteps",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortStepsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/sort/stats": {
      "post": {
        "tags": [
          "Sorting"
        ],
        "summary": "Compare how long each algorithm takes",
        "description": "Sort the same list with quick sort, merge sort, and heap sort, and report how long each took.\n\nUse it to see that the fastest algorithm depends on the input. Timings are measured on the server, in milliseconds, and vary from run to run. `timings` is ordered fastest first, and `fastest` names the winner.",
        "operationId": "compareSortAlgorithms",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SortStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Algorithm": {
        "type": "string",
        "enum": [
          "quick",
          "merge",
          "heap"
        ],
        "title": "Algorithm"
      },
      "AlgorithmTiming": {
        "properties": {
          "algorithm": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "The algorithm that was timed.",
            "examples": [
              "quick"
            ]
          },
          "elapsed_ms": {
            "type": "number",
            "title": "Elapsed Ms",
            "description": "How long the sort took, in milliseconds.",
            "examples": [
              0.042
            ]
          }
        },
        "type": "object",
        "required": [
          "algorithm",
          "elapsed_ms"
        ],
        "title": "AlgorithmTiming"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MergeStep": {
        "properties": {
          "step": {
            "type": "integer",
            "title": "Step",
            "description": "1-based position of this merge in the run.",
            "examples": [
              1
            ]
          },
          "left": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Left",
            "description": "The sorted left half going into the merge.",
            "examples": [
              [
                5
              ]
            ]
          },
          "right": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Right",
            "description": "The sorted right half going into the merge.",
            "examples": [
              [
                2
              ]
            ]
          },
          "merged": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Merged",
            "description": "The result of merging left and right.",
            "examples": [
              [
                2,
                5
              ]
            ]
          }
        },
        "type": "object",
        "required": [
          "step",
          "left",
          "right",
          "merged"
        ],
        "title": "MergeStep"
      },
      "Order": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "title": "Order"
      },
      "SortRequest": {
        "properties": {
          "numbers": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Numbers",
            "description": "The numbers to sort. Integers and decimals are both fine. Up to 1000 items.",
            "examples": [
              [
                5,
                2,
                9,
                1,
                5,
                6
              ]
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "Sort direction: `asc` (smallest first) or `desc` (largest first).",
            "default": "asc",
            "examples": [
              "asc"
            ]
          }
        },
        "type": "object",
        "required": [
          "numbers"
        ],
        "title": "SortRequest"
      },
      "SortResponse": {
        "properties": {
          "result": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Result",
            "description": "The sorted numbers.",
            "examples": [
              [
                1,
                2,
                5,
                5,
                6,
                9
              ]
            ]
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "How many numbers were sorted.",
            "examples": [
              6
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "The direction that was used.",
            "examples": [
              "asc"
            ]
          }
        },
        "type": "object",
        "required": [
          "result",
          "count",
          "order"
        ],
        "title": "SortResponse"
      },
      "SortStatsResponse": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "How many numbers were sorted.",
            "examples": [
              6
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "The direction that was used.",
            "examples": [
              "asc"
            ]
          },
          "result": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Result",
            "description": "The sorted numbers (identical for every algorithm).",
            "examples": [
              [
                1,
                2,
                5,
                5,
                6,
                9
              ]
            ]
          },
          "timings": {
            "items": {
              "$ref": "#/components/schemas/AlgorithmTiming"
            },
            "type": "array",
            "title": "Timings",
            "description": "One timing per algorithm, fastest first."
          },
          "fastest": {
            "$ref": "#/components/schemas/Algorithm",
            "description": "The algorithm that finished first on this input.",
            "examples": [
              "heap"
            ]
          }
        },
        "type": "object",
        "required": [
          "count",
          "order",
          "result",
          "timings",
          "fastest"
        ],
        "title": "SortStatsResponse"
      },
      "SortStepsResponse": {
        "properties": {
          "result": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Result",
            "description": "The sorted numbers.",
            "examples": [
              [
                1,
                2,
                5,
                5,
                6,
                9
              ]
            ]
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "description": "How many numbers were sorted.",
            "examples": [
              6
            ]
          },
          "order": {
            "$ref": "#/components/schemas/Order",
            "description": "The direction that was used.",
            "examples": [
              "asc"
            ]
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/MergeStep"
            },
            "type": "array",
            "title": "Steps",
            "description": "Every merge, in the order it happened."
          }
        },
        "type": "object",
        "required": [
          "result",
          "count",
          "order",
          "steps"
        ],
        "title": "SortStepsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Sorting",
      "description": "Sort a list of numbers."
    }
  ]
}
