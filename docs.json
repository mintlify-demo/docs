{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Mintlify Demo",
  "description": "A demo docs site showing what Mintlify can do: guides, interactive API references from OpenAPI, AI features, and multi-repo docs.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": false
  },
  "search": {
    "prompt": "Search the demo docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "bash",
        "python",
        "javascript",
        "go"
      ],
      "defaults": "all"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/mintlify-demo"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://mintlify.com/start"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "linkedin": "https://www.linkedin.com/company/mintlify",
      "github": "https://github.com/mintlify-demo"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Mintlify Demo",
      "twitter:site": "@mintlify"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Showcase",
            "icon": "sparkles",
            "pages": [
              "showcase/components",
              "showcase/ai"
            ]
          }
        ]
      },
      {
        "tab": "APIs",
        "icon": "code",
        "menu": [
          {
            "item": "Merge Sort API",
            "icon": "arrow-down-wide-short",
            "description": "Sort a list and see every merge step",
            "pages": [
              {
                "sourceRef": "mintlify-demo/merge-sort-api"
              }
            ]
          },
          {
            "item": "Calculator API",
            "icon": "calculator",
            "description": "Versions 1 and 2 side by side",
            "pages": [
              {
                "sourceRef": "mintlify-demo/calculator-api"
              }
            ]
          },
          {
            "item": "Todo API",
            "icon": "list-check",
            "description": "API key auth and pagination",
            "pages": [
              {
                "sourceRef": "mintlify-demo/todo-api"
              }
            ]
          },
          {
            "item": "Text Utils API",
            "icon": "font",
            "description": "Code samples in four languages",
            "pages": [
              {
                "sourceRef": "mintlify-demo/text-utils-api"
              }
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "clock-rotate-left",
        "pages": [
          "changelog"
        ]
      }
    ]
  }
}
