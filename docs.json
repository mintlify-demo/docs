                  {
                    "group": "API reference",
                    "icon": "code",
                    "openapi": {
                      "source": "text-utils-api/openapi.json",
                      "directory": "text-utils-api/api-reference"
                    }
                  }
                ]
              }
            ]
          },
          {
            "tab": "Changelog",
            "icon": "clock-rotate-left",
            "pages": [
              "changelog"
            ]
          }
        ]
