{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Mintlify Demo",
  "description": "A demo docs site showing what Mintlify can do: guides, interactive API references from OpenAPI, AI features, and docs kept in sync with code by Mintlify's agent.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": false
  },
  "search": {
    "prompt": "Search the demo docs..."
  },
  "metadata": {
    "timestamp": true
  },
  "api": {
    "playground": {
      "display": "auth",
      "proxy": false
    },
    "examples": {
      "languages": [
        "bash",
        "python",
        "javascript",
        "go"
      ],
      "defaults": "all",
      "prefill": true
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio",
      "devin",
      "windsurf",
      "mcp",
      "cursor",
      "vscode",
      "devin-mcp",
      "add-mcp",
      "download-spec",
      "download-pdf"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/mintlify-demo"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://mintlify.com/start"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "linkedin": "https://www.linkedin.com/company/mintlify",
      "github": "https://github.com/mintlify-demo"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Mintlify Demo",
      "twitter:site": "@mintlify"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Guides",
            "icon": "book-open",
            "groups": [
              {
                "group": "Get started",
                "icon": "rocket",
                "pages": [
                  "index",
                  "quickstart"
                ]
              },
              {
                "group": "Showcase",
                "icon": "sparkles",
                "pages": [
                  "showcase/components",
                  "showcase/ai"
                ]
              }
            ]
          },
          {
            "tab": "APIs",
            "icon": "code",
            "menu": [
              {
                "item": "Merge Sort API",
                "icon": "arrow-down-wide-short",
                "description": "Sort a list and see every merge step",
                "groups": [
                  {
                    "group": "Get started",
                    "icon": "rocket",
                    "pages": [
                      "merge-sort-api/index",
                      "merge-sort-api/quickstart"
                    ]
                  },
                  {
                    "group": "Guides",
                    "icon": "book-open",
                    "pages": [
                      "merge-sort-api/guides/how-it-works",
                      "merge-sort-api/guides/sorting-at-scale"
                    ]
                  },
                  {
                    "group": "API reference",
                    "icon": "code",
                    "openapi": {
                      "source": "merge-sort-api/openapi.json",
                      "directory": "merge-sort-api/api-reference"
                    }
                  }
                ]
              },
              {
                "item": "Calculator API",
                "icon": "calculator",
                "description": "Versions 1 and 2 side by side",
                "versions": [
                  {
                    "version": "v2",
                    "tag": "Latest",
                    "default": true,
                    "groups": [
                      {
                        "group": "Get started",
                        "icon": "rocket",
                        "pages": [
                          "calculator-api/index",
                          "calculator-api/quickstart"
                        ]
                      },
                      {
                        "group": "Guides",
                        "icon": "book-open",
                        "pages": [
                          "calculator-api/guides/v1-vs-v2",
                          "calculator-api/guides/errors"
                        ]
                      },
                      {
                        "group": "API reference",
                        "icon": "code",
                        "openapi": {
                          "source": "calculator-api/openapi.v2.json",
                          "directory": "calculator-api/api-reference"
                        }
                      }
                    ]
                  },
                  {
                    "version": "v1",
                    "tag": "Legacy",
                    "groups": [
                      {
                        "group": "Get started",
                        "icon": "rocket",
                        "pages": [
                          "calculator-api/v1/overview"
                        ]
                      },
                      {
                        "group": "API reference",
                        "icon": "code",
                        "openapi": {
                          "source": "calculator-api/openapi.v1.json",
                          "directory": "calculator-api/api-reference"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "item": "Todo API",
                "icon": "list-check",
                "description": "API key auth and pagination",
                "groups": [
                  {
                    "group": "Get started",
                    "icon": "rocket",
                    "pages": [
                      "todo-api/index",
                      "todo-api/quickstart"
                    ]
                  },
                  {
                    "group": "Guides",
                    "icon": "book-open",
                    "pages": [
                      "todo-api/guides/authentication",
                      "todo-api/guides/pagination",
                      "todo-api/guides/deprecations",
                      "todo-api/guides/partner-integrations",
                      "todo-api/guides/enterprise-bulk-import"
                    ]
                  },
                  {
                    "group": "API reference",
                    "icon": "code",
                    "openapi": {
                      "source": "todo-api/openapi.json",
                      "directory": "todo-api/api-reference"
                    }
                  },
                  {
                    "group": "GraphQL API",
                    "icon": "diagram-project",
                    "pages": [
                      "todo-api/graphql/overview"
                    ],
                    "graphql": {
                      "source": "todo-api/schema.graphql",
                      "directory": "todo-api/graphql/reference"
                    }
                  },
                  {
                    "group": "Event stream (WebSocket)",
                    "icon": "bolt",
                    "pages": [
                      "todo-api/events/overview"
                    ],
                    "asyncapi": {
                      "source": "todo-api/asyncapi.yaml",
                      "directory": "todo-api/events/reference"
                    }
                  },
                  {
                    "group": "Python SDK",
                    "icon": "python",
                    "pages": [
                      "todo-api/sdk/overview"
                    ],
                    "sdk": {
                      "format": "sphinx",
                      "source": "todo-api/sdk-artifacts/python",
                      "directory": "todo-api/sdk/reference"
                    }
                  }
                ]
              },
              {
                "item": "Text Utils API",
                "icon": "font",
                "description": "Code samples in four languages",
                "groups": [
                  {
                    "group": "Get started",
                    "icon": "rocket",
                    "pages": [
                      "text-utils-api/index",
                      "text-utils-api/quickstart"
                    ]
                  },
                  {
                    "group": "Guides",
                    "icon": "book-open",
                    "pages": [
                      "text-utils-api/guides/examples",
                      "text-utils-api/guides/partner-batch-processing"
                    ]
